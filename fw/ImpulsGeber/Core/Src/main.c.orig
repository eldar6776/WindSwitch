	HAL_UART_MspDeInit(&huart1);
	HAL_UART_MspDeInit(&huart2);
	HAL_RTC_MspDeInit(&hrtc);
	HAL_DeInit();
	HAL_NVIC_SystemReset();
	/* USER CODE END Init */

	while(1)
	{
	}
	/* USER CODE END Error_Handler_Debug */
}

